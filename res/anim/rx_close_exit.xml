<?xml version="1.0" encoding="utf-8"?>
<!-- Going back: the closing screen slides off to the right while fading out. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/accelerate_cubic" android:duration="220">
    <translate android:fromXDelta="0" android:toXDelta="8%p" />
    <alpha android:fromAlpha="1" android:toAlpha="0" />
</set>
