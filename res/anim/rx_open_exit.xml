<?xml version="1.0" encoding="utf-8"?>
<!-- The screen being left: drifts a little left and dims under the new one. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic" android:duration="260">
    <translate android:fromXDelta="0" android:toXDelta="-4%p" />
    <alpha android:fromAlpha="1" android:toAlpha="0.4" />
</set>
