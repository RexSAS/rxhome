<?xml version="1.0" encoding="utf-8"?>
<!-- Going back: the screen underneath slides back into place and brightens. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic" android:duration="240">
    <translate android:fromXDelta="-4%p" android:toXDelta="0" />
    <alpha android:fromAlpha="0.4" android:toAlpha="1" />
</set>
